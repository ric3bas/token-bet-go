# ==============================================================================
# TokenBet Solana Token Creator - Frontend Environment Variables
# ==============================================================================

# Carteira da Empresa que recebe todas as taxas em SOL (0.03 SOL base + 0.05 SOL revogações)
NEXT_PUBLIC_COMPANY_WALLET=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM
NEXT_PUBLIC_TREASURY_WALLET=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

# Rede Solana (devnet ou mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Endpoint RPC da Solana para Devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# RPC dedicado da Mainnet. O endpoint público api.mainnet-beta.solana.com pode
# recusar chamadas de aplicações web com HTTP 403; informe uma URL com a chave
# de API do seu provedor (Helius, QuickNode, Triton, etc.).
# crie/edite frontend/.env.local
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# URL do Backend .NET 10 (Web API)
BACKEND_API_URL=http://localhost:5236
